NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3012

# YouTube Data API v3
YOUTUBE_API_KEY=

# Neon Postgres (https://neon.tech) — DATABASE_URL은 pooled, UNPOOLED는 마이그레이션용
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth
BETTER_AUTH_URL=http://localhost:3012
BETTER_AUTH_SECRET=

# Google OAuth — 승인된 리디렉션 URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Toss Payments
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# Vercel Cron 인증
CRON_SECRET=
